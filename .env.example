# Server-only. Leave empty in git. Do not commit real values.

KNMI_API_KEY=
DATA_SYNC_SECRET=
DATABASE_URL=

# Weather alerts (meldingen)
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "WeerSport <meldingen@jouwdomein.nl>"
ALERT_FROM_EMAIL=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/internal/alerts/run
CRON_SECRET=
# Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:meldingen@jouwdomein.nl

# Public site settings
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ANALYTICS=

DATA_KNMI_ENABLED=false
DATA_RWS_ENABLED=false
DATA_PDOK_V2_ENABLED=false
DATA_LUCHTMEETNET_ENABLED=false
