{
  "name": "weersport",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check": "node scripts/check-phase01.mjs && node scripts/check-phase02.mjs && node scripts/check-phase03.mjs && node scripts/check-phase04.mjs && node scripts/check-phase05.mjs && node scripts/check-phase06.mjs && node scripts/check-phase07.mjs && node scripts/check-phase08.mjs && node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-sql-compat.ts && node scripts/check-pg-session.mjs && node scripts/check-pg-trace.mjs",
    "check:guides": "node scripts/check-sport-guides.mjs",
    "check:sponsor": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-sponsor-pilot.ts && node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-sportsponsor.ts",
    "check:data": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-data-integrations.ts",
    "sponsor": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/sponsor-admin.ts",
    "check:alerts": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-alerts.ts",
    "vapid": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "next": "^15.5.6",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.6",
    "typescript": "^5.9.2"
  }
}
